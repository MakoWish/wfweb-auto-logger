#!/usr/bin/env python3

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


# Define the WFWEB paths and remote API endpoints used by default.
DEFAULT_LOG = Path("/var/lib/wfweb/.local/share/wfweb/wfweb/qso-log.jsonl")
# Retain the original filenames so existing QRZ installations resume from their
# saved offset when they upgrade to the multi-service state format.
DEFAULT_STATE = Path("/var/lib/wfweb/.local/share/wfweb/wfweb/qrz-logger.state")
DEFAULT_FAILED = Path("/var/lib/wfweb/.local/share/wfweb/wfweb/qrz-logger-failed.jsonl")
QRZ_URL = "https://logbook.qrz.com/api"
EQSL_URL = "https://www.eqsl.cc/qslcard/ImportADIF.cfm"
CLUBLOG_URL = "https://clublog.org/realtime.php"
HRDLOG_URL = "https://robot.hrdlog.net/NewEntry.aspx"
HAMQTH_URL = "https://www.hamqth.com/qso_realtime.php"
RETRY_SECONDS = 30


#===============================================================================
# Write a status message immediately instead of waiting for output buffering
#===============================================================================
def log(msg):
    print(msg, flush=True)


#===============================================================================
# Write a status message only when verbose output is enabled
#===============================================================================
def verbose(args, msg):
    if args.verbose:
        log(msg)


#===============================================================================
# Format a non-empty value as an ADIF field
#===============================================================================
def adif_field(name, value):
    if value is None:
        return ""
    value = str(value).strip()
    return f"<{name}:{len(value)}>{value}" if value else ""


#===============================================================================
# Convert a WFWEB mode into its ADIF mode and optional submode
#===============================================================================
def normalize_mode(mode):
    mode = str(mode or "").strip().upper()
    mappings = {
        "USB": ("SSB", None), "LSB": ("SSB", None), "SSB": ("SSB", None),
        "FT8": ("FT8", None), "FT4": ("MFSK", "FT4"),
        "JS8": ("MFSK", "JS8"), "CW": ("CW", None),
        "AM": ("AM", None), "FM": ("FM", None),
        "RTTY": ("RTTY", None),
        "FREEDV": ("DIGITALVOICE", "FREEDV"),
        "DIGITALVOICE": ("DIGITALVOICE", None),
    }
    return mappings.get(mode, (mode, None))


#===============================================================================
# Validate a WFWEB QSO and serialize it as an ADIF record
#===============================================================================
def qso_to_adif(qso, station_callsign):
    call = str(qso.get("call", "")).strip().upper()
    date = str(qso.get("date", "")).strip()
    qso_time = str(qso.get("time", "")).strip()
    band = str(qso.get("band", "")).strip().lower()
    if not call:
        raise ValueError("QSO has no callsign")
    if len(date) != 8:
        raise ValueError(f"Invalid QSO date: {date!r}")
    if len(qso_time) not in (4, 6):
        raise ValueError(f"Invalid QSO time: {qso_time!r}")
    if not band:
        raise ValueError("QSO has no band")
    mode, submode = normalize_mode(qso.get("mode"))
    if not mode:
        raise ValueError("QSO has no mode")

    # Build required fields before appending values that may not be present.
    fields = [
        adif_field("CALL", call),
        adif_field("STATION_CALLSIGN", station_callsign.upper()),
        adif_field("QSO_DATE", date),
        adif_field("TIME_ON", qso_time),
        adif_field("BAND", band),
        adif_field("MODE", mode),
    ]
    if submode:
        fields.append(adif_field("SUBMODE", submode))
    try:
        freq_hz = int(qso.get("freq"))
        if freq_hz > 0:
            fields.append(adif_field(
                "FREQ", f"{freq_hz / 1_000_000:.6f}".rstrip("0").rstrip(".")
            ))
    except (TypeError, ValueError):
        pass
    if qso.get("rstSent"):
        fields.append(adif_field("RST_SENT", qso["rstSent"]))
    if qso.get("rstRcvd"):
        fields.append(adif_field("RST_RCVD", qso["rstRcvd"]))
    fields.append("<EOR>")
    return "".join(fields)


#===============================================================================
# Submit one ADIF record to the QRZ.com Logbook API
#===============================================================================
def submit_qrz(args, adif):
    payload = urllib.parse.urlencode({
        "KEY": args.qrz_api_key, "ACTION": "INSERT", "ADIF": adif,
    }).encode("utf-8")
    request = urllib.request.Request(
        QRZ_URL, data=payload, method="POST",
        headers={
            "User-Agent": f"wfweb-auto-logger/2.0 ({args.station_callsign})",
            "Content-Type": "application/x-www-form-urlencoded",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        body = response.read().decode("utf-8", errors="replace")
    result = dict((key.upper(), value) for key, value in
                  urllib.parse.parse_qsl(body, keep_blank_values=True))
    status = result.get("RESULT", "").upper()
    if status in ("OK", "REPLACE"):
        logid = result.get("LOGID") or result.get("LOGIDS") or "unknown"
        return True, f"{status}, LOGID={logid}"
    return False, result.get("REASON", body)


#===============================================================================
# Submit one ADIF record to the eQSL.cc ADIF import endpoint
#===============================================================================
def submit_eqsl(args, adif):
    # The eQSL real-time interface requires its service-specific eQSL_User and
    # eQSL_Pswd field names. Generic USERID and PASSWORD fields are not accepted.
    # QTHNickname is optional, but selects the desired station profile.
    header = "".join([
        adif_field("ADIF_VER", "3.1.0"),
        adif_field("PROGRAMID", "wfweb-auto-logger"),
        adif_field("eQSL_User", args.eqsl_username),
        adif_field("eQSL_Pswd", args.eqsl_password),
        adif_field("QTHNickname", args.eqsl_qth_nickname),
        "<EOH>",
    ])
    query = urllib.parse.urlencode({"ADIFData": header + adif})
    request = urllib.request.Request(
        f"{EQSL_URL}?{query}",
        headers={"User-Agent": "wfweb-auto-logger/2.0"},
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        body = response.read().decode("utf-8", errors="replace")

    # The legacy eQSL endpoint returns an HTML status page rather than a
    # machine-readable response. Its success text reports records added.
    normalized = " ".join(body.split()).lower()
    success = "1 out of 1 records added" in normalized
    if success:
        return True, "1 out of 1 records added"
    return False, "eQSL did not confirm the upload: " + " ".join(body.split())[:500]


#===============================================================================
# Submit one ADIF record to Club Log's real-time upload API
#===============================================================================
def submit_clublog(args, adif):
    payload = urllib.parse.urlencode({
        "email": args.clublog_email,
        "password": args.clublog_password,
        "callsign": args.station_callsign,
        "adif": adif,
        "api": args.clublog_api_key,
    }).encode("utf-8")
    request = urllib.request.Request(
        CLUBLOG_URL, data=payload, method="POST",
        headers={
            "User-Agent": f"wfweb-auto-logger/2.0 ({args.station_callsign})",
            "Content-Type": "application/x-www-form-urlencoded",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        body = response.read().decode("utf-8", errors="replace")
    message = " ".join(body.split())
    if message.upper() == "OK":
        return True, message
    return False, message or "Club Log returned an empty response"


#===============================================================================
# Submit one ADIF record to HRDLog.net's real-time upload API
#===============================================================================
def submit_hrdlog(args, adif):
    payload = urllib.parse.urlencode({
        "Callsign": args.station_callsign,
        "Code": args.hrdlog_code,
        "App": "wfweb-auto-logger",
        "QSO": adif,
    }).encode("utf-8")
    request = urllib.request.Request(
        HRDLOG_URL, data=payload, method="POST",
        headers={
            "User-Agent": f"wfweb-auto-logger/2.0 ({args.station_callsign})",
            "Content-Type": "application/x-www-form-urlencoded",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        body = response.read().decode("utf-8", errors="replace")
    message = " ".join(body.split())
    if message.upper() == "OK":
        return True, message
    return False, message or "HRDLog.net returned an empty response"


#===============================================================================
# Submit one ADIF record to HamQTH's real-time upload API
#===============================================================================
def submit_hamqth(args, adif):
    payload = urllib.parse.urlencode({
        "u": args.hamqth_username,
        "p": args.hamqth_password,
        "qso": adif,
    }).encode("utf-8")
    request = urllib.request.Request(
        HAMQTH_URL, data=payload, method="POST",
        headers={
            "User-Agent": f"wfweb-auto-logger/2.0 ({args.station_callsign})",
            "Content-Type": "application/x-www-form-urlencoded",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        body = response.read().decode("utf-8", errors="replace")
    message = " ".join(body.split())
    normalized = message.upper()
    if normalized == "OK" or "<STATUS>OK</STATUS>" in normalized:
        return True, message
    return False, message or "HamQTH returned an empty response"


#===============================================================================
# Read saved logger offsets, returning an empty state when none is usable
#===============================================================================
def read_state(path):
    try:
        with path.open("r", encoding="utf-8") as state_file:
            return json.load(state_file)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


#===============================================================================
# Resolve an offset for each enabled logger and migrate legacy QRZ state
#===============================================================================
def state_offsets(state, logger_names, inode, initial_offset):
    # A new inode indicates rotation, so an existing state restarts at zero.
    if state.get("inode") != inode:
        offset = 0 if state else initial_offset
        return {name: offset for name in logger_names}
    if isinstance(state.get("offsets"), dict):
        return {
            name: int(state["offsets"].get(name, initial_offset))
            for name in logger_names
        }
    # Migrate the original QRZ-only state file format.
    old_offset = int(state.get("offset", initial_offset))
    return {name: old_offset if name == "qrz" else initial_offset
            for name in logger_names}


#===============================================================================
# Atomically persist the current per-logger offsets
#===============================================================================
def write_state(path, inode, offsets):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w", encoding="utf-8") as state_file:
        json.dump({"inode": inode, "offsets": offsets}, state_file, sort_keys=True)
        state_file.write("\n")
    os.replace(tmp, path)


#===============================================================================
# Append a rejected or invalid QSO to the failure JSONL file
#===============================================================================
def record_failure(path, logger_name, qso, reason):
    path.parent.mkdir(parents=True, exist_ok=True)
    entry = {"logger": logger_name, "qso": qso, "reason": reason,
             "timestamp": int(time.time())}
    with path.open("a", encoding="utf-8") as failed_file:
        failed_file.write(json.dumps(entry, separators=(",", ":")) + "\n")


#===============================================================================
# Build the mapping of enabled logger names to submission functions
#===============================================================================
def configured_loggers(args):
    loggers = {}
    if args.enable_qrz:
        loggers["qrz"] = submit_qrz
    if args.enable_eqsl:
        loggers["eqsl"] = submit_eqsl
    if args.enable_clublog:
        loggers["clublog"] = submit_clublog
    if args.enable_hrdlog:
        loggers["hrdlog"] = submit_hrdlog
    if args.enable_hamqth:
        loggers["hamqth"] = submit_hamqth
    return loggers


#===============================================================================
# Submit a QSO to one logger and classify the result for retry handling
#===============================================================================
def process_for_logger(args, logger_name, submit, qso, adif):
    if args.dry_run:
        log(f"DRY RUN: not submitting to {logger_name.upper()}")
        return True
    try:
        accepted, message = submit(args, adif)
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError) as exc:
        log(f"{logger_name.upper()} network error: {exc}")
        return False
    verbose(args, f"{logger_name.upper()} response: {message}")
    if accepted:
        log(f"{logger_name.upper()}: {message}")
    else:
        log(f"{logger_name.upper()} rejected QSO: {message}")
        record_failure(args.failed_file, logger_name, qso, message)
    # Service-level rejections are preserved and handled; only transient
    # network errors remain pending for retry.
    return True


#===============================================================================
# Follow the WFWEB JSONL file and deliver each QSO to every enabled logger
#===============================================================================
def follow(args):
    loggers = configured_loggers(args)
    state = read_state(args.state_file)
    while True:
        try:
            stat = args.log_file.stat()
        except FileNotFoundError:
            verbose(args, f"Waiting for {args.log_file}")
            time.sleep(2)
            continue
        inode = stat.st_ino
        initial = 0 if args.from_start else stat.st_size
        offsets = state_offsets(state, loggers, inode, initial)
        # A same-inode truncation invalidates offsets beyond the new EOF.
        offsets = {name: offset if offset <= stat.st_size else 0
                   for name, offset in offsets.items()}
        if not args.dry_run:
            write_state(args.state_file, inode, offsets)
        start = min(offsets.values())
        verbose(args, f"Watching {args.log_file} (inode={inode}, offsets={offsets})")

        with args.log_file.open("r", encoding="utf-8") as log_file:
            log_file.seek(start)
            while True:
                line_offset = log_file.tell()
                line = log_file.readline()
                if line:
                    next_offset = log_file.tell()
                    # Only call services that have not advanced past this line.
                    due = [name for name, offset in offsets.items()
                           if offset <= line_offset]
                    try:
                        qso = json.loads(line)
                        adif = qso_to_adif(qso, args.station_callsign)
                        log(f"QSO {qso.get('call', '?')} {qso.get('band', '?')} "
                            f"{qso.get('mode', '?')}")
                        verbose(args, f"ADIF: {adif}")
                    except (json.JSONDecodeError, ValueError) as exc:
                        log(f"Invalid QSO at offset {line_offset}: {exc}")
                        qso = None
                        for name in due:
                            if not args.dry_run:
                                record_failure(args.failed_file, name, {"raw": line.rstrip()}, str(exc))
                            offsets[name] = next_offset
                    if qso is not None:
                        retry = False
                        for name in due:
                            try:
                                handled = process_for_logger(
                                    args, name, loggers[name], qso, adif
                                )
                            except Exception as exc:
                                log(f"{name.upper()} processing error: {exc}")
                                if not args.dry_run:
                                    record_failure(args.failed_file, name, qso, str(exc))
                                handled = True
                            if handled:
                                offsets[name] = next_offset
                            else:
                                retry = True
                    if not args.dry_run:
                        write_state(args.state_file, inode, offsets)
                    if qso is not None and retry:
                        log(f"Pending logger(s) will retry in {RETRY_SECONDS} seconds.")
                        time.sleep(RETRY_SECONDS)
                    log_file.seek(min(offsets.values()))
                    continue

                time.sleep(1)
                try:
                    new_stat = args.log_file.stat()
                except FileNotFoundError:
                    break
                if new_stat.st_ino != inode or new_stat.st_size < log_file.tell():
                    state = read_state(args.state_file)
                    break


#===============================================================================
# Parse command-line settings and validate credentials for enabled loggers
#===============================================================================
def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Upload new WFWEB QSO log entries to enabled logging services"
    )
    parser.add_argument("--log-file", type=Path, default=DEFAULT_LOG)
    parser.add_argument("--state-file", type=Path, default=DEFAULT_STATE)
    parser.add_argument("--failed-file", type=Path, default=DEFAULT_FAILED)
    parser.add_argument("--from-start", action="store_true",
                        help="Process existing QSO records instead of starting at EOF")
    parser.add_argument("--dry-run", action="store_true",
                        help="Show records and ADIF without sending them")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--station-callsign",
                        default=os.environ.get("STATION_CALLSIGN") or
                        os.environ.get("QRZ_STATION_CALLSIGN"))
    parser.add_argument("--enable-qrz", action="store_true")
    parser.add_argument("--qrz-api-key", default=os.environ.get("QRZ_API_KEY"))
    parser.add_argument("--enable-eqsl", action="store_true")
    parser.add_argument("--eqsl-username", default=os.environ.get("EQSL_USERNAME"))
    parser.add_argument("--eqsl-password", default=os.environ.get("EQSL_PASSWORD"))
    parser.add_argument("--eqsl-qth-nickname", default=os.environ.get("EQSL_QTH_NICKNAME"))
    parser.add_argument("--enable-clublog", action="store_true")
    parser.add_argument("--clublog-email", default=os.environ.get("CLUBLOG_EMAIL"))
    parser.add_argument("--clublog-password", default=os.environ.get("CLUBLOG_PASSWORD"))
    parser.add_argument("--clublog-api-key", default=os.environ.get("CLUBLOG_API_KEY"))
    parser.add_argument("--enable-hrdlog", action="store_true")
    parser.add_argument("--hrdlog-code", default=os.environ.get("HRDLOG_CODE"))
    parser.add_argument("--enable-hamqth", action="store_true")
    parser.add_argument("--hamqth-username", default=os.environ.get("HAMQTH_USERNAME"))
    parser.add_argument("--hamqth-password", default=os.environ.get("HAMQTH_PASSWORD"))
    args = parser.parse_args(argv)
    # Report all configuration errors together so they can be fixed at once.
    errors = []
    enabled = (args.enable_qrz, args.enable_eqsl, args.enable_clublog,
               args.enable_hrdlog, args.enable_hamqth)
    if not any(enabled):
        errors.append("enable at least one logging service")
    if not args.station_callsign:
        errors.append("supply --station-callsign or STATION_CALLSIGN")
    if args.enable_qrz and not args.qrz_api_key:
        errors.append("--enable-qrz requires --qrz-api-key or QRZ_API_KEY")
    if args.enable_eqsl and (not args.eqsl_username or not args.eqsl_password):
        errors.append("--enable-eqsl requires eQSL username and password")
    if args.enable_clublog and not all((args.clublog_email,
                                        args.clublog_password,
                                        args.clublog_api_key)):
        errors.append("--enable-clublog requires email, password, and API key")
    if args.enable_hrdlog and not args.hrdlog_code:
        errors.append("--enable-hrdlog requires --hrdlog-code or HRDLOG_CODE")
    if args.enable_hamqth and not all((args.hamqth_username,
                                      args.hamqth_password)):
        errors.append("--enable-hamqth requires username and password")
    if errors:
        parser.error("; ".join(errors))
    return args


#===============================================================================
# Run the logger until it is interrupted
#===============================================================================
def main():
    args = parse_args()
    try:
        follow(args)
    except KeyboardInterrupt:
        log("Stopped.")
        return 0


if __name__ == "__main__":
    sys.exit(main())
